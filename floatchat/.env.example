# FloatChat backend environment template.
#
# Copy this file to `.env` (same directory) and adjust values for your
# machine. `.env` is git-ignored on purpose — never commit real machine
# paths or API keys.
#
# All variables use the FLOATCHAT_ prefix (see floatchat.config.Settings).
# Values here are OPTIONAL: unset variables fall back to portable defaults.

# ── Data lake location (most important, machine-specific) ────────────────
# The repository ships NO data lake and NO machine-specific default path.
# Point this at your local Phase 2 lake root, e.g.:
#   Windows: FLOATCHAT_DATA_LAKE_DIR=E:\floatchat_data_lake\
#   Linux:   FLOATCHAT_DATA_LAKE_DIR=/data/floatchat_lake
# When unset (or the directory has no populated parquet/levels), the app
# falls back to the Phase 1 path below, and /health reports "degraded"
# unless that path also contains data.
#FLOATCHAT_DATA_LAKE_DIR=

# Phase 1 fallback lake root (relative paths resolve against the process
# working directory). The test suite overrides this to the committed fixture
# lake, so tests never depend on this value.
#FLOATCHAT_DATA_LAKE_ROOT=.data_lake/parquet

# ── LLM provider (ollama is fully offline; gemini/groq are cloud) ────────
#FLOATCHAT_LLM_PROVIDER=ollama
#FLOATCHAT_GEMINI_API_KEY=
#FLOATCHAT_GROQ_API_KEY=

# ── Misc ──────────────────────────────────────────────────────────────────
#FLOATCHAT_LOG_LEVEL=INFO
#FLOATCHAT_DEPLOYMENT_MODE=GLOBAL
